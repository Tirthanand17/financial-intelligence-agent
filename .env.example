APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

POSTGRES_DB=fia
POSTGRES_USER=fia
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://fia:change_me@localhost:5432/fia

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=financial_knowledge

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=fiaadmin
MINIO_SECRET_KEY=change_me
