APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Hosted PostgreSQL (Supabase recommended for the free prototype).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# Qdrant Cloud. Keep the API key private.
QDRANT_URL=https://YOUR-CLUSTER.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=financial_knowledge
QDRANT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
QDRANT_VECTOR_NAME=dense
QDRANT_VECTOR_SIZE=384

# S3-compatible private object storage. Backblaze B2 is the currently validated provider.
# Example endpoint shape: https://s3.<region>.backblazeb2.com
S3_ENDPOINT_URL=https://s3.YOUR-REGION.backblazeb2.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=financial-intelligence-agent-data
S3_REGION=YOUR-REGION

MAX_DOWNLOAD_MB=50
CHUNK_SIZE_CHARS=3500
CHUNK_OVERLAP_CHARS=400

# Safety gate. Keep false until real dated primary + independent corroboration
# has passed the Phase 4 live validation process.
TRUST_PROMOTION_ENABLED=false

# Phase 5 monitoring remains fail-closed. Feed observation and automatic ingestion
# are separate switches; enabling monitoring must not automatically follow links.
SOURCE_MONITORING_ENABLED=false
SOURCE_AUTO_INGEST_ENABLED=false

# Quotas are never guessed. Leave ceilings unset until deliberately chosen for
# the current cloud plans. Missing ceilings make capacity UNKNOWN and pause work.
MONITOR_SUPABASE_MAX_MB=
MONITOR_B2_MAX_MB=
MONITOR_QDRANT_MAX_POINTS=
MONITOR_CAPACITY_LOW_WATERMARK_PERCENT=10

# Reserved for a later grounded-generation layer. Never commit real keys.
OPENAI_API_KEY=
CHAT_MODEL=
