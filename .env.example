# Local embedding model; first run downloads model files.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MAX_DOWNLOAD_MB=50
CHUNK_SIZE_CHARS=3500
CHUNK_OVERLAP_CHARS=400

